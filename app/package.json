{
  "name": "galaxy-connect-for-arm64",
  "productName": "Galaxy Connect for ARM64",
  "version": "1.0.0",
  "description": "Unofficial helper that lets Galaxy Connect run on non-Samsung Windows ARM64 PCs",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable --arm64"
  },
  "build": {
    "appId": "io.github.galaxy-connect-for-arm64",
    "productName": "Galaxy Connect for ARM64",
    "artifactName": "GalaxyConnectForARM64-${version}-arm64-portable.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "scripts",
        "filter": [
          "Apply.ps1",
          "Backup.ps1",
          "Restore.ps1",
          "Status.ps1",
          "lib/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "arm64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.2",
    "@fontsource/noto-sans-kr": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  }
}
